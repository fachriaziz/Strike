---
import favicon from '../assets/brand/mark-dark.svg?url';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Strike',
	description = 'Learn the basics of pool. Explore the equipment, rules, and techniques.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
