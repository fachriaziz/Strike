---
import brandMark from '../assets/brand/mark-dark.svg?url';

interface Props {
	homeHref?: string;
}

const { homeHref = '' } = Astro.props;
---

<footer class="bg-surface">
	<div class="page-width footer-inner">
		<a class="brand" href={`${homeHref}#hero`}>
			<img src={brandMark} width="30" height="26" alt="" />
			<span>Strike</span>
		</a>
		<p class="text-label font-medium">Created by the Strike team.</p>
	</div>
</footer>

<style>
	.footer-inner {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: space-between;
		min-block-size: 7rem;
		gap: 0.75rem 2rem;
		padding-block: 1.5rem;
	}
</style>
